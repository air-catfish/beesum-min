<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Test doubles for this repo's own tests; not published to NuGet. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Beesum.Testing</PackageId>
    <Title>Beesum.Testing</Title>
    <Description>In-memory test doubles and AddBeesumTesting() for Beesum.Core.</Description>
    <PackageTags>beesum;testing;fakes;in-memory;xunit;dependencies</PackageTags>
    <PackageIcon>beesum-min-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Beesum.Core/Beesum.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../assets/icon/beesum-min-128.png" Pack="true" PackagePath="\" />
    <None Include="../../docs/package-readme-testing.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
