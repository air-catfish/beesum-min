<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>beesum-mcp</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>beesum-mcp</ToolCommandName>
    <PackageId>beesum-mcp</PackageId>
    <Title>beesum-mcp</Title>
    <Description>MCP stdio server for beesum-min: summarize YouTube URLs or supplied transcripts from an LLM agent.</Description>
    <PackageTags>mcp;model-context-protocol;youtube;summarizer;transcript;yt-dlp;llm;cli</PackageTags>
    <PackageIcon>beesum-min-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Beesum.Core/Beesum.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Beesum.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../assets/icon/beesum-min-128.png" Pack="true" PackagePath="\" />
    <None Include="../../docs/package-readme-mcp.md" Pack="true" PackagePath="README.md" />
    <None Include=".mcp/server.json" Pack="true" PackagePath="/.mcp/" />
  </ItemGroup>

</Project>
