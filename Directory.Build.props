<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.3</Version>

    <!-- NuGet metadata shared by every packable project. -->
    <Authors>air-catfish and Beesum contributors</Authors>
    <Product>beesum-min</Product>
    <Copyright>Copyright (c) 2026 Beesum contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/air-catfish/beesum-min</PackageProjectUrl>
    <RepositoryUrl>https://github.com/air-catfish/beesum-min</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>See https://github.com/air-catfish/beesum-min/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- Строгость: предупреждения = ошибки. Если build покраснеет —
         сначала гасим конкретные коды в .editorconfig, потом уже здесь. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Воспроизводимость сборки -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- SourceLink is restored on CI only: the local sandbox has no NuGet access. -->
  <ItemGroup Condition="'$(CI)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
